# Copy this file to `.env` in the project root and fill in real values.
# `.env` is already in .gitignore — never commit real credentials.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Email (required for verification / password-reset emails to actually
# send instead of just printing to the console) ---------------------------
# Example using a Gmail account with a 16-character "App Password"
# (Google Account -> Security -> 2-Step Verification -> App passwords):
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-address@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=Mintique <your-address@gmail.com>

# Alternative for quick local testing without a real inbox: sign up for a
# free Mailtrap.io sandbox and use its SMTP credentials instead of Gmail's.

# --- Google OAuth (optional) ----------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- WalletConnect (optional) ---------------------------------------------
WALLETCONNECT_PROJECT_ID=

# --- Polygon blockchain (optional — off-chain simulated mint is used until
# NFT_CONTRACT_ADDRESS is set) ----------------------------------------------
# "amoy" (testnet, default) or "mainnet"
POLYGON_NETWORK=amoy
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_MAINNET_RPC_URL=https://polygon-rpc.com
# Address of the deployed MintiqueNFT contract from contracts/MintiqueNFT.sol
NFT_CONTRACT_ADDRESS=
# Optional — address of the deployed ERC-1155 companion contract from
# contracts/MintiqueNFT1155.sol, for multi-edition drops. Leave blank
# until you actually need multi-token minting; see contracts/README.md.
NFT_CONTRACT_ADDRESS_ERC1155=

# --- IPFS via Pinata (optional — required for real IPFS pinning; get a JWT
# at https://app.pinata.cloud/developers/api-keys) --------------------------
PINATA_JWT=
PINATA_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/
