# Copy to .env and fill in. Never commit the real .env file.

# Deployer wallet private key (no 0x prefix stripping needed either way).
# Use a throwaway/dedicated deploy wallet, never your main wallet.
PRIVATE_KEY=290f785fea7f7226d03cd77c9288131967f1be575034edecf2733b218fd6f607

# RPC endpoints — get free ones from Alchemy, Infura, or a public RPC.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-api-key
AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/alch_9fzeaQZv0Z8d5VBT92rHn
POLYGON_RPC_URL=https://polygon-rpc.com

# Optional: contract verification on Etherscan/Polygonscan.
ETHERSCAN_API_KEY=
POLYGONSCAN_API_KEY=

# Constructor args for scripts/deploy.js
NFT_NAME=Mintique
NFT_SYMBOL=MNTQ
# Address that becomes the contract owner (defaults to the deployer if blank).
NFT_OWNER_ADDRESS=0x41c1A376Bb77E51d85c90ABDA6A08d1f52f1b966
# 0 = uncapped supply.
NFT_MAX_SUPPLY=0
